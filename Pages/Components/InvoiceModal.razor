@using Store.Data
@using Store.Models
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject InvoiceService invoiceService;
<style>
    
    .invoiceTitle {
        text-align: center;
        border: 1px solid;
        background: aliceblue;
        font-weight: bold;
        font-size: 1.5rem;
    }

</style>
@if (IsVisible)
{
    <div class="modal-overlay">
        <div class="modal-window wide" @onclick:stopPropagation>
            <div class="cart card-title">
                <h4>@store Receipt</h4>
            </div>
            <div class="cart card-content printable">
                <table class="table invTbl white" style="margin-bottom:.5rem;">
                        <tbody>
                            <tr>
                                <td>Bill No.: <strong>@invoice.BillNo</strong></td>
                                <td>Date: @invoice.Date.ToString()</td>
                            </tr>
                    </tbody>
                </table>
                <div style="height: 300px; overflow-y: auto;">
                    <table class="table invTbl white">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Unit</th>
                                <th>Quantity</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @attribute [Authorize]
                            @foreach (var item in invoice.Items)
                            {
                                <tr>
                                    <td>@item.Product.Name</td>
                                    <td>@item.Price</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.Price</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- More items -->
                <div class="total-summary">
                    <!--<div class="mb-3" style="display: flex">
                    <label>Customer Name</label>
                    <InputText @bind-Value="invoice.CusName" class="form-control" />
                    </div>-->
                    <table class="table invTbl white">
                        <tbody>
                            <tr>
                                <td>Tax(%):</td>
                                <td>@invoice.Tax.ToString()</td>
                                <td>Amount:</td>
                                <td>@invoice.Amount.ToString("C2")</td>
                            </tr>
                            <tr>
                                <td>Tax Amount      :</td>
                                <td>@invoice.TaxAmount?.ToString("C2")</td>
                                <td><strong>Total:</strong></td>
                                <td><strong>@invoice.TotalAmount?.ToString("C")</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--<div class="btn-group">
                <button class="selected">Cash</button>
                <button>Debit</button>
                <button>E-Wallet</button>
                </div>-->
                <div class="btn-bar">
                    <button type="button" class="btn btn-success nonprint" @onclick="Print">Print</button>
                    <button type="button" class="btn btn-primary nonprint" @onclick="Close">Close</button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public string BillNo { get; set; }

    public Invoice? invoice { get; set; }
    private bool _previousVisible;
   private string? store;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !_previousVisible)
        {
            if (!string.IsNullOrEmpty(BillNo))
            {
                await GetInvoice();
            }
        }
        _previousVisible = IsVisible;
    }

    private async Task GetInvoice()
    {
        store = Configuration["ClientName"];
        invoice = await invoiceService.GetInvoiceAsync(BillNo);
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(IsVisible);
    }

    private async Task Print(){
        await JS.InvokeVoidAsync("window.print");
    }
}
